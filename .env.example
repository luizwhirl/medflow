# Copie para .env (cp .env.example .env) e ajuste se necessário.

# Banco (docker-compose)
POSTGRES_DB=medflow
POSTGRES_USER=medflow
POSTGRES_PASSWORD=medflow
POSTGRES_PORT=5432

# pgAdmin (opcional: docker compose --profile tools up)
PGADMIN_EMAIL=admin@medflow.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Backend (lidos pelo Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/medflow
DB_USER=medflow
DB_PASSWORD=medflow
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
# JWT (autenticação). Obrigatório fora do perfil dev: pelo menos 32 caracteres, gerado e secreto.
# Ex.: openssl rand -base64 48
# JWT_SECRET=
# JWT_EXPIRACAO=8h
